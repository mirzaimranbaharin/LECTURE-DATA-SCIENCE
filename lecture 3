              48,50,52,55,56,57,63,63,65,65,66,71,77,79,82,89,108,110,115,135),
  Solar_R = c(290,44,320,149,120,137,112,27,238,274,65,334,13,299,19,285,224,190,9,345,
              193,220,230,259,238,236,190,220,279,286,287,236,203,258,213,236,223,190,259,269),
  Wind    = c(9.2,9.7,16.6,12.6,11.5,10.3,11.5,10.3,12.6,10.9,13.2,11.5,12.0,8.6,20.1,14.9,9.7,7.4,10.9,14.3,
