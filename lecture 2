install.packages("readr")

# Load required libraries
library(dplyr)
library(readr)

student_data <- read.csv("C:/Users/imran/Downloads/student_data.csv")

# Preview the data
head(student_data)
tail(student_data)

# Check structure
str(student_data)

#FILTER
# Filter students who failed the final exam (mark < 40)
student_fail <- student_data %>% filter(final_exam_mark < 40)
print(student_fail)

# Filter students who passed the final exam (mark >= 40)
student_pass <- student_data %>% filter(final_exam_mark >= 40)
print(student_pass)

#ARRANGE
# Arrange passing students by final_exam_mark (ascending)
mydata_asc <- student_data %>%
  filter(final_exam_mark > 40) %>%
  arrange(final_exam_mark)
print(mydata_asc)

# Arrange passing students by final_exam_mark (descending)
mydata_desc <- student_data %>%
  filter(final_exam_mark > 40) %>%
  arrange(desc(final_exam_mark))
print(mydata_desc)

#SELECT
# Select only specific columns
mydata_select <- student_data %>%
  select(student_id, coursework_mark, final_exam_mark)
print(mydata_select)

# Peek at structure of selected columns
glimpse(mydata_select)

#MUTATE
# Formula: coursework (50%) + final exam (50%)
mydata_mutate <- student_data %>%
  mutate(Total_Mark = (coursework_mark * 0.5) + (final_exam_mark * 0.5))
print(mydata_mutate)

# Add grade classification based on Total_Mark
mydata_mutate <- mydata_mutate %>%
  mutate(Grade = case_when(
    Total_Mark >= 80 ~ "A",
    Total_Mark >= 70 ~ "B",
    Total_Mark >= 60 ~ "C",
    Total_Mark >= 50 ~ "D",
    TRUE             ~ "F"
  ))
print(mydata_mutate)

#DESCRIPTIVE STATISTICS
# Central Tendency
cat("\n--- Coursework Mark ---\n")
cat("Mean:   ", mean(student_data$coursework_mark), "\n")
cat("Median: ", median(student_data$coursework_mark), "\n")

cat("\n--- Final Exam Mark ---\n")
cat("Mean:   ", mean(student_data$final_exam_mark), "\n")
cat("Median: ", median(student_data$final_exam_mark), "\n")

# Variability/Dispersion
cat("\n--- Spread: Coursework Mark ---\n")
cat("Min:    ", min(student_data$coursework_mark), "\n")
cat("Max:    ", max(student_data$coursework_mark), "\n")
cat("Range:  ", range(student_data$coursework_mark), "\n")
cat("SD:     ", sd(student_data$coursework_mark), "\n")
cat("Var:    ", var(student_data$coursework_mark), "\n")

cat("\n--- Spread: Final Exam Mark ---\n")
cat("Min:    ", min(student_data$final_exam_mark), "\n")
cat("Max:    ", max(student_data$final_exam_mark), "\n")
cat("Range:  ", range(student_data$final_exam_mark), "\n")
cat("SD:     ", sd(student_data$final_exam_mark), "\n")
cat("Var:    ", var(student_data$final_exam_mark), "\n")

# Quantiles
cat("\n--- Quantiles: Final Exam Mark ---\n")
quantile(student_data$final_exam_mark)
cat("Q1 (25%): ", quantile(student_data$final_exam_mark, 0.25), "\n")
cat("Q3 (75%): ", quantile(student_data$final_exam_mark, 0.75), "\n")
cat("IQR:      ", IQR(student_data$final_exam_mark), "\n")

# Full Summary
cat("\n--- Full Summary ---\n")
summary(student_data)

# Count checks
cat("\nTotal rows:    ", nrow(student_data), "\n")
cat("Total columns: ", ncol(student_data), "\n")
cat("Missing values in coursework_mark: ", sum(is.na(student_data$coursework_mark)), "\n")
cat("Missing values in final_exam_mark: ", sum(is.na(student_data$final_exam_mark)), "\n")

# VISUALIZATIONS (Descriptive Analytics)
# Histogram of Final Exam Mark
hist(student_data$final_exam_mark,
     main  = "Histogram of Final Exam Mark",
     xlab  = "Final Exam Mark",
     col   = "lightblue",
     border = "white")

# Boxplot of Final Exam Mark grouped by Gender
boxplot(final_exam_mark ~ gender,
        data  = student_data,
        main  = "Final Exam Mark by Gender",
        xlab  = "Gender",
        ylab  = "Final Exam Mark",
        col   = c("lightpink", "lightblue"))

# Scatter plot: Coursework Mark vs Final Exam Mark
plot(student_data$coursework_mark,
     student_data$final_exam_mark,
     main = "Coursework Mark vs Final Exam M ark",
     xlab = "Coursework Mark",
     ylab = "Final Exam Mark",
     col  = "steelblue",
     pch  = 16)
abline(lm(final_exam_mark ~ coursework_mark, data = student_data),
       col = "red", lty = 2)

# OUTLIER DETECTION & HANDLING (IQR Method)
# Detect outliers in final_exam_mark
q1  <- quantile(student_data$final_exam_mark, 0.25)
q3  <- quantile(student_data$final_exam_mark, 0.75)
iqr <- IQR(student_data$final_exam_mark)
le  <- q1 - 1.5 * iqr  # lower extreme
ue  <- q3 + 1.5 * iqr  # upper extreme

cat("\nOutlier bounds for final_exam_mark:\n")
cat("Lower Extreme: ", le, "\n")
cat("Upper Extreme: ", ue, "\n")

# Show outliers
outliers <- student_data %>%
  filter(final_exam_mark < le | final_exam_mark > ue)
cat("Outliers found:\n")
print(outliers)

# Visualise before treatment
boxplot(student_data$final_exam_mark,
        main = "Final Exam Mark - Before Outlier Treatment",
        col  = "lightyellow")

# Option A: Replace outliers with mean
student_treated_mean <- student_data
avg <- round(mean(student_treated_mean$final_exam_mark))
student_treated_mean$final_exam_mark[student_treated_mean$final_exam_mark < le] <- avg
student_treated_mean$final_exam_mark[student_treated_mean$final_exam_mark > ue] <- avg

# Option B: Replace outliers with boundary values (capping)
student_treated_cap <- student_data
student_treated_cap$final_exam_mark[student_treated_cap$final_exam_mark < le] <- le
student_treated_cap$final_exam_mark[student_treated_cap$final_exam_mark > ue] <- ue

# Visualise after capping
boxplot(student_treated_cap$final_exam_mark,
        main = "Final Exam Mark - After Outlier Capping",
        col  = "lightgreen")

